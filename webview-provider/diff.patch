+    private static JSONArray serializeTrace(StackTraceElement[] stackTrace) {
+        JSONArray traceArray = new JSONArray();
+        for (StackTraceElement element : stackTrace) {
+            traceArray.put(element.toString());
+        }
+        return traceArray;
+    }
+
+    private static JSONArray serializeArray(Object array) {
+        JSONArray jsonArray = new JSONArray();
+        int length = java.lang.reflect.Array.getLength(array);
+        for (int i = 0; i < length; i++) {
+            jsonArray.put(serializeObject(java.lang.reflect.Array.get(array, i)));
+        }
+        return jsonArray;
+    }
+
+    private static JSONArray serializeCollection(java.util.Collection<?> collection) {
+        JSONArray jsonArray = new JSONArray();
+        for (Object item : collection) {
+            jsonArray.put(serializeObject(item));
+        }
+        return jsonArray;
+    }
+
+    private static Object serializeObject(Object object) {
+        if (object == null) {
+            return JSONObject.NULL;
+        } else if (object instanceof String) {
+            return JSONObject.quote((String) object);
+        } else if (object.getClass().isArray()) {
+            return serializeArray(object);
+        } else if (object instanceof Number || object instanceof Boolean) {
+            return object;
+        } else if (object instanceof java.util.Collection) {
+            return serializeCollection((java.util.Collection<?>) object);
+        } else {
+            return JSONObject.quote(object.toString());
+        }
+    }
+
+    private static JSONArray serializeParams(Object[] params) {
+        JSONArray jsonArray = new JSONArray();
+        for (Object param : params) {
+            jsonArray.put(serializeObject(param));
+        }
+        return jsonArray;
+    }
