+    public static void maybeSaveFileForUrl(String url) {
+        if (url == null || url.isEmpty()) {
+            return;
+        }
+
+        // We need to get rid of query and fragment to have a consistent file name
+        Uri originalUri = Uri.parse(url);
+        Uri.Builder builder = originalUri.buildUpon();
+        builder.clearQuery();
+        builder.fragment(null);
+        
+        Uri bareUri = builder.build();
+        String bareUrl = bareUri.toString();
+
+        // Generate the output file name
+        String outputFileName = android.util.Base64.encodeToString(
+            bareUrl.getBytes(), 
+            android.util.Base64.URL_SAFE | android.util.Base64.NO_WRAP
+        );
+
+        Context context = org.chromium.base.ContextUtils.getApplicationContext();
+        String scheme = bareUri.getScheme();
+        String path = bareUri.getPath();
+
+        if (sFileAndroidAssetPattern.matcher(url).matches()) {
+            saveAndroidAssetOrResourceFile(context, path, outputFileName, bareUrl);
+        } else if (url.startsWith("file:")) {
+            logFileSaved(context, bareUrl, outputFileName, null);
+        }
+    }
