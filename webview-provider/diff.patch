+    public static void recordWebViewApiCall(String id, int sample, Object[] parameters) {
+        java.lang.StackTraceElement[] stackTrace = java.lang.Thread.currentThread().getStackTrace();
+
+        Context context = org.chromium.base.ContextUtils.getApplicationContext();
+
+        // delete all until com.android.webview has ended (this is not necessarily the firs)
+        int startIndex = 0;
+        boolean started = false;
+        for (int i = 0; i < stackTrace.length; i++) {
+            if (stackTrace[i].getClassName().startsWith("com.android.webview")) {
+                started = true;
+            } else if (started) {
+                startIndex = i;
+                break;
+            }
+        }
+
+        stackTrace = java.util.Arrays.copyOfRange(stackTrace, startIndex, stackTrace.length - 1);
+
+        // check if the stack Trace starts with calls to android.webkit. and remove them if so
+        while (stackTrace.length > 0 && stackTrace[0].getClassName().startsWith("android.webkit.")) {
+            stackTrace = java.util.Arrays.copyOfRange(stackTrace, 1, stackTrace.length);
+        }
+
+        JSONArray traceArray = serializeTrace(stackTrace);
+        JSONArray paramsArray = serializeParams(parameters);
+
+        JSONObject jsonLog = new JSONObject();
+        try {
+            jsonLog.put("webview_id", id);
+            jsonLog.put("package", context.getPackageName());
+            jsonLog.put("api_id", sample);
+            jsonLog.put("params", paramsArray);
+            jsonLog.put("trace", traceArray);
+        } catch (JSONException e) {
+            e.printStackTrace();
+        }
+
+        String logString = jsonLog.toString();
+
+        if (logString.length() > 3900) {
+            String uuid = java.util.UUID.randomUUID().toString();
+            writeFileUsingOutputStream(context, logString, "33file44-" + uuid);
+            Log.i("33WV_API_CALL44", "33filedump44-" + sample + "-33file44-" + uuid + "_" + context.getPackageName());
+        } else {
+            Log.i("33WV_API_CALL44", logString);
+        }
+    }
