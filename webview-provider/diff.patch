+    private static void saveAndroidAssetOrResourceFile(Context context, String filePath, String outputFileName, String bareUrl) {
+        if (filePath.contains("android_asset")) {
+            String assetFilePath = filePath.split("android_asset/")[1];
+            saveAndroidAssetFile(context, assetFilePath, outputFileName, bareUrl);
+        } else if (filePath.contains("android_res")) {
+            String resourceFilePath = filePath.split("android_res/")[1];
+            saveAndroidResourceFile(context, resourceFilePath, outputFileName, bareUrl);
+        }
+    }
+
+    private static void saveAndroidResourceFile(Context context, String resourceFilePath, String outputFileName, String bareUrl) {
+        File filesDir = context.getFilesDir();
+        File myFile = new File(filesDir, outputFileName);
+        if (myFile.exists()) {
+            Log.i("33WV_LOG_CALL44", "File already exists: " + myFile.getAbsolutePath());
+            return;
+        }
+
+        try {
+            String[] parts = resourceFilePath.split("/");
+            String resourceName = parts[parts.length - 1];
+            String resourceNameWithoutExtension = resourceName.split("\\.")[0];
+            try (InputStream inputStream = context.getResources().openRawResource(
+                context.getResources().getIdentifier(resourceNameWithoutExtension, "raw", context.getPackageName()))) {
+                writeFileUsingOutputStream(context, inputStream, outputFileName);
+                logFileSaved(context, bareUrl, outputFileName, outputFileName);
+            } catch (IOException e) {
+                Log.e("33WV_LOG_CALL44_E", "Error writing file with InputStream: " + resourceFilePath, e);
+            }
+        } catch (Exception e) {
+            Log.e("33WV_LOG_CALL44_E", "Error getting resource ID: " + resourceFilePath, e);
+        }        
+    }
+
+    private static void saveAndroidAssetFile(Context context, String assetFilePath, String outputFileName, String bareUrl) {
+        File filesDir = context.getFilesDir();
+        File myFile = new File(filesDir, outputFileName);
+        if (myFile.exists()) {
+            Log.i("33WV_LOG_CALL44", "File already exists: " + myFile.getAbsolutePath());
+            return;
+        }
+        
+        AssetManager assetManager = context.getAssets();
+        try (InputStream inputStream = assetManager.open(assetFilePath)) {
+            writeFileUsingOutputStream(context, inputStream, outputFileName);
+            logFileSaved(context, bareUrl, outputFileName, outputFileName);
+        } catch (IOException e) {
+            Log.e("33WV_LOG_CALL44_E", "Error writing file with InputStream: " + assetFilePath, e);
+        }
+    }
+
+    private static void writeFileUsingOutputStream(Context context, InputStream inputStream, String fileName) {
+        File filesDir = context.getFilesDir();
+        File myFile = new File(filesDir, fileName);
+        try (FileOutputStream fos = new FileOutputStream(myFile)) {
+            byte[] buffer = new byte[1024];
+            int bytesRead;
+            while ((bytesRead = inputStream.read(buffer)) != -1) {
+                fos.write(buffer, 0, bytesRead);
+            }
+            fos.getFD().sync();  // Force write to disk
+        } catch (IOException e) {
+            Log.e("33WV_LOG_CALL44_E", "Error writing file with OutputStream: " + myFile.getAbsolutePath(), e);
+        }
+    }
+
+
+    private static void writeFileUsingOutputStream(Context context, String data, String fileName) {
+        File filesDir = context.getFilesDir();
+        File myFile = new File(filesDir, fileName);
+        try (FileOutputStream fos = new FileOutputStream(myFile)) {
+            if (data != null && !data.isEmpty()) {
+                fos.write(data.getBytes());  // Write raw bytes
+                fos.getFD().sync();  // Force write to disk
+            }
+        } catch (IOException e) {
+            Log.e("33WV_LOG_CALL44_E", "Error writing file with OutputStream: " + myFile.getAbsolutePath(), e);
+        }
